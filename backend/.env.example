PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/agentblazer
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# SMTP (used for OTP, contact form and recruitment result emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_club_email@gmail.com
SMTP_PASS=your_app_password

# Local development only (leave unset on Vercel). Use if you get
# "self-signed certificate in certificate chain" when sending email.
# SMTP_ALLOW_SELF_SIGNED=true
